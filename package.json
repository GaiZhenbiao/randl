{
  "name": "randl-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "check": "npm run check -w backend && npm run check -w frontend",
    "test:browser": "node tests/browser.mjs",
    "start": "node backend/dist/cli.js serve",
    "test": "npm run build -w backend && node --test tests/*.test.mjs",
    "randl": "node backend/dist/cli.js",
    "format": "prettier --write --no-error-on-unmatched-pattern backend/src frontend/src tests/*.mjs scripts/*.mjs *.md docs",
    "test:resources": "node tests/resources.mjs",
    "test:media": "node tests/media-browser.mjs",
    "test:display": "node tests/display-layout-browser.mjs",
    "test:sdk": "npm run build -w backend && node tests/sdk-gate.mjs",
    "test:charts": "node tests/charts-browser.mjs && node tests/plot-hover-browser.mjs && node tests/area-hover-browser.mjs && node tests/hover-updates-browser.mjs && node tests/focused-run-browser.mjs && node tests/grouped-charts-browser.mjs",
    "test:scroll-cache": "node tests/scroll-cache-browser.mjs",
    "test:resolution": "node tests/chart-resolution-browser.mjs",
    "test:zoom": "node tests/drag-zoom-browser.mjs",
    "test:agent": "node tests/agent-browser.mjs && node tests/agent-profile-browser.mjs",
    "test:auth": "node tests/auth-browser.mjs",
    "test:projects": "node tests/project-lifecycle-browser.mjs",
    "test:shell": "node tests/shell-details-browser.mjs",
    "test:mobile-nav": "node tests/mobile-nav-browser.mjs",
    "test:plugins": "node tests/plugin-browser.mjs",
    "test:languages": "node tests/languages-browser.mjs",
    "test:agent:live": "node tests/agent-live.mjs",
    "test:reorder": "node tests/reorder-browser.mjs",
    "test:metrics": "node tests/metric-catalog-browser.mjs && node tests/metrics-browser.mjs",
    "test:run-query": "node tests/run-query-performance.mjs",
    "test:run-selection": "node tests/run-selection-performance.mjs",
    "test:open-latency": "node tests/open-latency-browser.mjs",
    "test:run-controls": "node tests/run-controls-browser.mjs && node tests/run-state-group-browser.mjs",
    "test:bulk-selection": "node tests/bulk-selection-browser.mjs",
    "test:run-focus": "node tests/run-focus-browser.mjs",
    "test:panel-icons": "node tests/panel-icons-browser.mjs",
    "test:runs-table": "node tests/runs-table-browser.mjs",
    "test:snapshots": "node tests/snapshot-browser.mjs",
    "test:workspace-header": "node tests/workspace-header-browser.mjs",
    "test:plot-settings": "node tests/plot-settings-browser.mjs && node tests/outliers-browser.mjs",
    "test:smoothing": "node tests/smoothing-browser.mjs",
    "test:columns": "node tests/columns-browser.mjs && node tests/choice-touch-browser.mjs",
    "test:transforms": "node tests/record-transforms-browser.mjs",
    "test:run-stop": "npm run build -w backend && node tests/run-stop-browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1"
  }
}
